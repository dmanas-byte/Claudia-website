# Where both forms POST (JSON body). Any endpoint that accepts POST works:
# Formspree, Basin, Getform, Netlify Forms proxy, a Cloudflare Worker, ...
# Leave empty to run forms in "demo" mode (submissions are logged, never sent).
VITE_FORM_ENDPOINT=

# Show the proof wall (SHOT 11). Keep false until testimonials with written
# permission on file exist. Never ship invented testimonials.
VITE_SHOW_TESTIMONIALS=false
